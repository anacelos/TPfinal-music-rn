@@ -0,0 +1,40 @@
+"""Public, blind API for the new study only."""
+
+from flask import Blueprint, current_app, jsonify, request
+from sqlalchemy.exc import SQLAlchemyError
+
+from app.services.scenarios import (
+    ScenarioError, participant_progress, reserve_scenarios, submit_scenario_response,
+)
+
+
+scenarios_bp = Blueprint("scenarios", __name__)
+
+
+@scenarios_bp.errorhandler(ScenarioError)
+def scenario_error(error):
+    return jsonify({"error": str(error)}), error.status_code
+
+
+@scenarios_bp.errorhandler(SQLAlchemyError)
+def database_error(error):
+    current_app.logger.exception("Scenario operation failed")
+    # SQLAlchemy messages can include private storage paths and presentation data.
+    return jsonify({"error": "Scenario operation failed; please retry"}), 503
+
+
+@scenarios_bp.post("/scenarios/reserve")
+def reserve():
+    return jsonify(reserve_scenarios(request.headers.get("uuid")))
+
+
+@scenarios_bp.get("/scenarios/mine")
+def mine():
+    return jsonify(participant_progress(request.headers.get("uuid")))
+
+
+@scenarios_bp.post("/scenario-responses/submit")
+def submit():
+    return jsonify(submit_scenario_response(
+        request.headers.get("uuid"), request.get_json(silent=True),
+    ))
diff --git a/app/scenario_models.py b/app/scenario_models.py
new file mode 100644
index 0000000..0596506
--- /dev/null
+++ b/app/scenario_models.py
@@ -0,0 +1,151 @@
+"""Models for the scenario study; independent of the legacy pair study."""
+
+import enum
+import secrets
+import uuid
+from datetime import datetime, timezone
+
+from sqlalchemy import CheckConstraint, UniqueConstraint
+from sqlalchemy.orm import validates
+from sqlalchemy.types import DateTime, TypeDecorator
+
+from app.repository import db
+
+
+def utc_now():
+    return datetime.now(timezone.utc)
+
+
+def new_id():
+    return str(uuid.uuid4())
+
+
+def new_token():
+    return secrets.token_urlsafe(32)
+
+
+class UTCDateTime(TypeDecorator):
+    """Preserve aware UTC datetimes, including on SQLite round trips."""
+
+    impl = DateTime(timezone=True)
+    cache_ok = True
+
+    def process_bind_param(self, value, dialect):
+        if value is None:
+            return None
+        if value.tzinfo is None or value.utcoffset() is None:
+            raise ValueError("Timestamps must be timezone-aware")
+        return value.astimezone(timezone.utc)
+
+    def process_result_value(self, value, dialect):
+        if value is None:
+            return None
+        if value.tzinfo is None:
+            return value.replace(tzinfo=timezone.utc)
+        return value.astimezone(timezone.utc)
+
+
+class ScenarioStatus(str, enum.Enum):
+    AVAILABLE = "AVAILABLE"
+    RESERVED = "RESERVED"
+    COMPLETED = "COMPLETED"
+
+
+class AudioOrigin(str, enum.Enum):
+    real = "real"
+    markov = "markov"
+    neural = "neural"
+    attention = "attention"
+
+
+def enum_column(enum_class, name):
+    return db.Enum(
+        enum_class, name=name, native_enum=False, create_constraint=True,
+        validate_strings=True, values_callable=lambda items: [item.value for item in items],
+    )
+
+
+class Scenario(db.Model):
+    __tablename__ = "scenario"
+
+    id = db.Column(db.String(36), primary_key=True, default=new_id)
+    external_id = db.Column(db.String(255), unique=True)
+    context_image = db.Column(db.Text)
+    game_description = db.Column(db.Text, nullable=False)
+    scene_description = db.Column(db.Text, nullable=False)
+    status = db.Column(
+        enum_column(ScenarioStatus, "scenario_status"), nullable=False,
+        default=ScenarioStatus.AVAILABLE, index=True,
+    )
+    reserved_by = db.Column(db.String(36), db.ForeignKey("user.uuid"), index=True)
+    reserved_at = db.Column(UTCDateTime())
+    reserved_until = db.Column(UTCDateTime(), index=True)
+    reservation_id = db.Column(db.String(64), unique=True)
+    audio_order = db.Column(db.JSON)
+    completed_at = db.Column(UTCDateTime())
+    created_at = db.Column(UTCDateTime(), nullable=False, default=utc_now)
+
+    audios = db.relationship("ScenarioAudio", back_populates="scenario")
+
+    @validates("status")
+    def validate_status(self, key, value):
+        return ScenarioStatus(value)
+
+
+class ScenarioAudio(db.Model):
+    __tablename__ = "scenario_audio"
+    __table_args__ = (
+        UniqueConstraint("scenario_id", "origin", name="uq_scenario_audio_origin"),
+    )
+
+    id = db.Column(db.String(36), primary_key=True, default=new_id)
+    public_id = db.Column(db.String(64), nullable=False, unique=True, default=new_token)
+    scenario_id = db.Column(db.String(36), db.ForeignKey("scenario.id"), nullable=False, index=True)
+    origin = db.Column(enum_column(AudioOrigin, "scenario_audio_origin"), nullable=False)
+    storage_key = db.Column(db.Text, nullable=False)
+
+    scenario = db.relationship("Scenario", back_populates="audios")
+
+    @validates("origin")
+    def validate_origin(self, key, value):
+        return AudioOrigin(value)
+
+
+class ScenarioResponse(db.Model):
+    __tablename__ = "scenario_response"
+    __table_args__ = (
+        UniqueConstraint("scenario_id", name="uq_scenario_response_scenario"),
+        *(CheckConstraint(
+            "score_{0} BETWEEN 1 AND 5 AND score_{0} = CAST(score_{0} AS INTEGER)".format(label),
+            name="ck_scenario_response_score_" + label,
+        ) for label in "abcd"),
+        CheckConstraint(
+            "time_spent_ms >= 0 AND time_spent_ms = CAST(time_spent_ms AS BIGINT)",
+            name="ck_scenario_response_time_spent",
+        ),
+    )
+
+    id = db.Column(db.String(36), primary_key=True, default=new_id)
+    scenario_id = db.Column(db.String(36), db.ForeignKey("scenario.id"), nullable=False)
+    participant_uuid = db.Column(db.String(36), db.ForeignKey("user.uuid"), nullable=False, index=True)
+    reservation_id = db.Column(db.String(64), nullable=False)
+    score_a = db.Column(db.Integer, nullable=False)
+    score_b = db.Column(db.Integer, nullable=False)
+    score_c = db.Column(db.Integer, nullable=False)
+    score_d = db.Column(db.Integer, nullable=False)
+    presented_order = db.Column(db.JSON, nullable=False)
+    reserved_at = db.Column(UTCDateTime(), nullable=False)
+    submitted_at = db.Column(UTCDateTime(), nullable=False, default=utc_now)
+    time_spent_ms = db.Column(db.BigInteger, nullable=False)
+
+    @validates("score_a", "score_b", "score_c", "score_d")
+    def validate_score(self, key, value):
+        if type(value) is not int or not 1 <= value <= 5:
+            raise ValueError("Scores must be integers between 1 and 5")
+        return value
+
+    @validates("time_spent_ms")
+    def validate_time_spent(self, key, value):
+        if type(value) is not int or not 0 <= value <= 9223372036854775807:
+            raise ValueError("time_spent_ms must be a nonnegative 64-bit integer")
+        return value
diff --git a/app/services/scenarios.py b/app/services/scenarios.py
new file mode 100644
index 0000000..4c2d8a3
--- /dev/null
+++ b/app/services/scenarios.py
@@ -0,0 +1,254 @@
+"""Transactional scenario allocation, completion and public serialization.
+
+Each operation owns a short-lived SQLAlchemy session. SQLite writers acquire
+BEGIN IMMEDIATE before reading; PostgreSQL writers lock the participant and
+scenario rows. No legacy study counters or responses are used.
+"""
+
+import secrets
+from contextlib import contextmanager
+from datetime import timedelta
+from uuid import UUID
+
+from flask import current_app
+from sqlalchemy import func, select, update
+from sqlalchemy.orm import Session
+
+from app.models import User
+from app.repository import db
+from app.scenario_models import (
+    AudioOrigin, Scenario, ScenarioAudio, ScenarioResponse, ScenarioStatus,
+    new_token, utc_now,
+)
+
+
+LABELS = ("A", "B", "C", "D")
+RANDOM = secrets.SystemRandom()
+
+
+class ScenarioError(Exception):
+    def __init__(self, message, status_code=400):
+        super().__init__(message)
+        self.status_code = status_code
+
+
+def _positive_integer(value, name):
+    if type(value) is not int or value < 1:
+        raise ScenarioError(name + " must be a positive integer")
+    return value
+
+
+def configured_target():
+    return _positive_integer(current_app.config.get("SCENARIOS_PER_PARTICIPANT", 4), "target")
+
+
+def _participant_id(value):
+    if not isinstance(value, str):
+        raise ScenarioError("UUID is missing or invalid")
+    try:
+        UUID(value)
+    except ValueError:
+        raise ScenarioError("UUID is missing or invalid") from None
+    return value
+
+
+@contextmanager
+def _transaction(write=True):
+    with Session(db.engine, expire_on_commit=False) as session:
+        with session.begin():
+            if write and db.engine.dialect.name == "sqlite":
+                session.connection().exec_driver_sql("BEGIN IMMEDIATE")
+            yield session
+
+
+def _participant(session, participant_uuid, lock=True):
+    statement = select(User).where(User.uuid == participant_uuid)
+    if lock:
+        statement = statement.with_for_update()
+    if session.execute(statement).scalar_one_or_none() is None:
+        raise ScenarioError("Participant not found", 404)
+
+
+def _release_expired(session, now):
+    result = session.execute(
+        update(Scenario).where(
+            Scenario.status == ScenarioStatus.RESERVED,
+            Scenario.reserved_until <= now,
+        ).values(
+            status=ScenarioStatus.AVAILABLE, reserved_by=None, reserved_at=None,
+            reserved_until=None, reservation_id=None, audio_order=None,
+        ), execution_options={"synchronize_session": False},
+    )
+    return result.rowcount
+
+
+def release_expired_reservations():
+    """Release expired leases only, without touching completed scenarios."""
+    with _transaction() as session:
+        return _release_expired(session, utc_now())
+
+
+def _eligible_scenarios():
+    valid_audio_scenarios = (
+        select(ScenarioAudio.scenario_id)
+        .group_by(ScenarioAudio.scenario_id)
+        .having(func.count(ScenarioAudio.id) == len(LABELS))
+        .having(func.count(func.distinct(ScenarioAudio.origin)) == len(AudioOrigin))
+    )
+    return select(Scenario).where(
+        Scenario.status == ScenarioStatus.AVAILABLE,
+        Scenario.completed_at.is_(None),
+        Scenario.id.in_(valid_audio_scenarios),
+        ~select(ScenarioResponse.id).where(
+            ScenarioResponse.scenario_id == Scenario.id,
+        ).exists(),
+    )
+
+
+def _valid_reservations(session, participant_uuid, now):
+    return session.execute(
+        select(Scenario).where(
+            Scenario.status == ScenarioStatus.RESERVED,
+            Scenario.reserved_by == participant_uuid,
+            Scenario.reserved_until > now,
+        ).order_by(Scenario.reserved_at, Scenario.id),
+    ).scalars().all()
+
+
+def _completed_count(session, participant_uuid):
+    return session.scalar(select(func.count()).select_from(ScenarioResponse).where(
+        ScenarioResponse.participant_uuid == participant_uuid,
+    ))
+
+
+def _public_reservation(session, scenario):
+    # Deliberate allowlist: never serialize models, internal IDs, paths or origins.
+    audios = {audio.id: audio for audio in session.execute(
+        select(ScenarioAudio).where(ScenarioAudio.scenario_id == scenario.id),
+    ).scalars()}
+    return {
+        "scenario_id": scenario.id,
+        "reservation_id": scenario.reservation_id,
+        "reserved_until": scenario.reserved_until.isoformat(),
+        "context_image": scenario.context_image,
+        "game_description": scenario.game_description,
+        "scene_description": scenario.scene_description,
+        "audios": [
+            {"label": label, "public_id": audios[scenario.audio_order[label]].public_id}
+            for label in LABELS
+        ],
+    }
+
+
+def _progress(session, participant_uuid, target, now):
+    completed = _completed_count(session, participant_uuid)
+    return {
+        "completed_count": completed,
+        "target": target,
+        "whether_complete": completed >= target,
+        "reservations": [
+            _public_reservation(session, item)
+            for item in _valid_reservations(session, participant_uuid, now)
+        ],
+    }
+
+
+def reserve_scenarios(participant_uuid, target=None):
+    participant_uuid = _participant_id(participant_uuid)
+    target = configured_target() if target is None else _positive_integer(target, "target")
+    minutes = _positive_integer(current_app.config.get("RESERVATION_MINUTES", 30), "RESERVATION_MINUTES")
+    with _transaction() as session:
+        _participant(session, participant_uuid)
+        now = utc_now()
+        _release_expired(session, now)
+        current = _valid_reservations(session, participant_uuid, now)
+        missing = max(0, target - _completed_count(session, participant_uuid) - len(current))
+        if missing:
+            candidates = session.execute(
+                _eligible_scenarios().order_by(Scenario.created_at, Scenario.id)
+                .limit(missing).with_for_update(skip_locked=True),
+            ).scalars().all()
+            for scenario in candidates:
+                audios = session.execute(select(ScenarioAudio).where(
+                    ScenarioAudio.scenario_id == scenario.id,
+                ).order_by(ScenarioAudio.id)).scalars().all()
+                shuffled = RANDOM.sample([audio.id for audio in audios], len(LABELS))
+                scenario.status = ScenarioStatus.RESERVED
+                scenario.reserved_by = participant_uuid
+                scenario.reserved_at = now
+                scenario.reserved_until = now + timedelta(minutes=minutes)
+                scenario.reservation_id = new_token()
+                scenario.audio_order = dict(zip(LABELS, shuffled))
+            session.flush()
+        return _progress(session, participant_uuid, target, now)
+
+
+def participant_progress(participant_uuid):
+    participant_uuid = _participant_id(participant_uuid)
+    with _transaction(write=False) as session:
+        _participant(session, participant_uuid, lock=False)
+        return _progress(session, participant_uuid, configured_target(), utc_now())
+
+
+def _validate_submission(payload):
+    fields = {"scenario_id", "reservation_id", "scores", "time_spent_ms"}
+    if not isinstance(payload, dict) or set(payload) != fields:
+        raise ScenarioError("Expected only scenario_id, reservation_id, scores and time_spent_ms")
+    if any(not isinstance(payload[key], str) or not payload[key] for key in ("scenario_id", "reservation_id")):
+        raise ScenarioError("scenario_id and reservation_id must be nonempty strings")
+    if not payload["reservation_id"].isascii() or len(payload["reservation_id"]) > 64:
+        raise ScenarioError("reservation_id is invalid")
+    scores = payload["scores"]
+    if not isinstance(scores, dict) or set(scores) != set(LABELS):
+        raise ScenarioError("Exactly the labels A, B, C and D are required")
+    if any(type(value) is not int or not 1 <= value <= 5 for value in scores.values()):
+        raise ScenarioError("Scores must be integers between 1 and 5")
+    elapsed = payload["time_spent_ms"]
+    if type(elapsed) is not int or not 0 <= elapsed <= 9223372036854775807:
+        raise ScenarioError("time_spent_ms must be a nonnegative 64-bit integer")
+
+
+def submit_scenario_response(participant_uuid, payload):
+    participant_uuid = _participant_id(participant_uuid)
+    _validate_submission(payload)
+    with _transaction() as session:
+        _participant(session, participant_uuid)
+        scenario = session.execute(select(Scenario).where(
+            Scenario.id == payload["scenario_id"],
+        ).with_for_update()).scalar_one_or_none()
+        if scenario is None:
+            raise ScenarioError("Scenario not found", 404)
+        existing = session.execute(select(ScenarioResponse).where(
+            ScenarioResponse.scenario_id == scenario.id,
+        )).scalar_one_or_none()
+        if existing is not None:
+            if (existing.participant_uuid != participant_uuid or
+                    not secrets.compare_digest(existing.reservation_id, payload["reservation_id"])):
+                raise ScenarioError("Submission does not belong to this reservation", 403)
+            if any(getattr(existing, "score_" + label.lower()) != payload["scores"][label]
+                   for label in LABELS):
+                raise ScenarioError("Completed responses cannot be changed", 409)
+            return {"scenario_id": scenario.id, "status": "COMPLETED", "already_completed": True}
+        if scenario.status != ScenarioStatus.RESERVED:
+            raise ScenarioError("Scenario is not reserved", 409)
+        if (scenario.reserved_by != participant_uuid or
+                not secrets.compare_digest(scenario.reservation_id or "", payload["reservation_id"])):
+            raise ScenarioError("Submission does not belong to this reservation", 403)
+        now = utc_now()
+        if scenario.reserved_until is None or scenario.reserved_until <= now:
+            raise ScenarioError("Reservation has expired", 409)
+        if not isinstance(scenario.audio_order, dict) or set(scenario.audio_order) != set(LABELS):
+            raise ScenarioError("Reservation presentation is invalid", 409)
+        response = ScenarioResponse(
+            scenario_id=scenario.id, participant_uuid=participant_uuid,
+            reservation_id=scenario.reservation_id,
+            presented_order=dict(scenario.audio_order), reserved_at=scenario.reserved_at,
+            submitted_at=now, time_spent_ms=payload["time_spent_ms"],
+            **{"score_" + label.lower(): payload["scores"][label] for label in LABELS},
+        )
+        session.add(response)
+        scenario.status = ScenarioStatus.COMPLETED
+        scenario.completed_at = now
+        # Keep the lease and presentation as an audit trail. Expiry only touches RESERVED.
+        session.flush()
+        return {"scenario_id": scenario.id, "status": "COMPLETED", "already_completed": False}
diff --git a/tests/README.md b/tests/README.md
new file mode 100644
index 0000000..d66eeed
--- /dev/null
+++ b/tests/README.md
@@ -0,0 +1,75 @@
+# Scenario backend tests
+
+Run only the new suite from the repository root:
+
+```bash
+PYTHONDONTWRITEBYTECODE=1 .venv/bin/python -B -m unittest discover -s tests -p 'test_scenarios.py' -v
+```
+
+The suite uses standard-library `unittest`, Flask's test client, and a fresh SQLite
+file under `TemporaryDirectory` for every test. It constructs its own Flask app,
+enables SQLite foreign keys, and registers only the new blueprint. It never imports
+`app.server` or `app.config`, reads their database configuration, or runs migrations.
+`db.create_all()` runs exclusively against those disposable test databases.
+
+## New API
+
+All three endpoints use the existing `uuid` header and require an existing User:
+
+- `POST /scenarios/reserve`
+- `GET /scenarios/mine`
+- `POST /scenario-responses/submit`
+
+Configure `SCENARIOS_PER_PARTICIPANT` (default 4) and `RESERVATION_MINUTES` (default
+30) through the backend environment or Flask config. The reserve endpoint does not
+accept a participant-selected target. Progress returns `completed_count`, `target`,
+`whether_complete`, and `reservations`; an empty stock does not imply completion.
+
+Each reservation exposes context and four `{label, public_id}` audio objects. No
+playable media URL exists yet. `public_id` is an opaque identifier, not a media
+authorization mechanism; a future media endpoint must validate the current lease.
+Internal `audio_order` is JSON mapping A/B/C/D to ScenarioAudio primary keys.
+The server copies it to the immutable response's `presented_order` on submission.
+Every new lease gets a fresh random token and an independently shuffled order;
+random permutations may coincide by chance. Resuming a valid lease never shuffles
+or extends its deadline.
+
+Submission accepts exactly:
+
+```json
+{
+  "scenario_id": "<id>",
+  "reservation_id": "<opaque-token>",
+  "scores": {"A": 1, "B": 2, "C": 4, "D": 5},
+  "time_spent_ms": 12000
+}
+```
+
+A retry with the same participant, lease and scores returns success with
+`already_completed: true`, even with a different valid elapsed time. The original
+elapsed time and all stored response fields are preserved. Different scores return
+409; a different participant/token returns 403. Booleans, floating-point scores, missing/extra
+labels, and client-provided presentation/origin fields are rejected. The UUID
+header retains the legacy pseudonymous identity mechanism; this is not a new
+identity authentication system.
+
+Expired RESERVED rows are reset inside the reservation transaction. The standalone
+`release_expired_reservations()` service performs the same cleanup. Neither touches
+COMPLETED rows. Submission rejects expired leases even before cleanup. Completed
+rows preserve lease metadata for audit and are protected by a unique response per
+scenario.
+
+## Transaction scope and remaining deployment work
+
+Each service operation owns a separate SQLAlchemy session and commits once.
+SQLite write operations use `BEGIN IMMEDIATE` before reading, serializing writers;
+lock contention can time out and is returned as a generic 503 for retry. Tests
+cover simultaneous allocations for different participants and for one UUID.
+PostgreSQL uses a participant row lock plus scenario row locks and `SKIP LOCKED`
+for allocation. Real PostgreSQL concurrency and deployment migrations remain out
+of scope and still need validation. SQLite throughput is limited by its single
+writer model. UTC timestamps survive SQLite round trips as aware datetimes.
+
+No production schema has been created by this work. Do not use the legacy startup
+as a harmless schema inspection: it still calls `db.create_all()`, and the legacy
+Docker entrypoint still generates/applies migrations. Both behaviors are unchanged.
