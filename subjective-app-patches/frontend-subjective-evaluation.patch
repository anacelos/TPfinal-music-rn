new file mode 100644
index 0000000..e9df20e
--- /dev/null
+++ b/src/lib/scenario-api.ts
@@ -0,0 +1,55 @@
+import axios from 'axios';
+import { AUDIO_LABELS } from '../types/scenario_types';
+import type {
+  ScenarioAudio, ScenarioProgress, ScenarioSubmission, ScenarioSubmissionResult,
+} from '../types/scenario_types';
+
+const api = axios.create({ baseURL: import.meta.env.PUBLIC_SERVER_URL, timeout: 15000 });
+
+function readProgress(data: ScenarioProgress): ScenarioProgress {
+  if (!data || !Number.isInteger(data.target) || data.target < 1 ||
+      !Number.isInteger(data.completed_count) || data.completed_count < 0 ||
+      typeof data.whether_complete !== 'boolean' || !Array.isArray(data.reservations)) {
+    throw new Error('Resposta de progresso inválida.');
+  }
+  for (const scenario of data.reservations) {
+    if (!scenario || typeof scenario.scenario_id !== 'string' ||
+        typeof scenario.reservation_id !== 'string' ||
+        !Number.isFinite(Date.parse(scenario.reserved_until)) ||
+        typeof scenario.scene_description !== 'string' ||
+        typeof scenario.game_description !== 'string' ||
+        !(scenario.context_image === null || typeof scenario.context_image === 'string') ||
+        !Array.isArray(scenario.audios) || scenario.audios.length !== AUDIO_LABELS.length ||
+        new Set(scenario.audios.map(audio => audio?.label)).size !== AUDIO_LABELS.length ||
+        !scenario.audios.every(audio => audio && AUDIO_LABELS.includes(audio.label) &&
+          typeof audio.public_id === 'string' && audio.public_id.length > 0)) {
+      throw new Error('Resposta de cenário inválida.');
+    }
+  }
+  return data;
+}
+
+export async function getScenarioProgress(uuid: string): Promise<ScenarioProgress> {
+  const response = await api.get<ScenarioProgress>('/scenarios/mine', { headers: { uuid } });
+  return readProgress(response.data);
+}
+
+export async function reserveScenarios(uuid: string): Promise<ScenarioProgress> {
+  const response = await api.post<ScenarioProgress>('/scenarios/reserve', null, { headers: { uuid } });
+  return readProgress(response.data);
+}
+
+export async function submitScenario(uuid: string, payload: ScenarioSubmission): Promise<void> {
+  const response = await api.post<ScenarioSubmissionResult>(
+    '/scenario-responses/submit', payload, { headers: { uuid } },
+  );
+  if (response.data?.scenario_id !== payload.scenario_id || response.data.status !== 'COMPLETED') {
+    throw new Error('Não foi possível confirmar a conclusão do cenário.');
+  }
+}
+
+export function resolveScenarioAudioSource(_audio: ScenarioAudio): string | undefined {
+  // The current contract supplies public_id only. Replace this adapter when the
+  // backend supplies playable neutral URLs; do not guess a media endpoint.
+  return undefined;
+}
