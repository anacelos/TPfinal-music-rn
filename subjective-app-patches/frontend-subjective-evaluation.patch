@@ -0,0 +1,51 @@
+import AudioPlayer from 'react-h5-audio-player';
+import 'react-h5-audio-player/lib/styles.css';
+import type { ScenarioAudio, Score } from '../types/scenario_types';
+
+const SCALE: ReadonlyArray<{ value: Score; text: string }> = [
+  { value: 1, text: 'Não combina nada' },
+  { value: 2, text: 'Combina pouco' },
+  { value: 3, text: 'Mais ou menos' },
+  { value: 4, text: 'Combina bem' },
+  { value: 5, text: 'Combina muito bem' },
+];
+
+interface Props {
+  audio: ScenarioAudio;
+  source?: string;
+  score?: Score;
+  disabled: boolean;
+  onScoreChange: (score: Score) => void;
+}
+
+export default function ScenarioAudioCard({ audio, source, score, disabled, onScoreChange }: Props) {
+  return (
+    <section className="scenario-audio-card" aria-labelledby={`music-${audio.label}`}>
+      <h2 id={`music-${audio.label}`} className="scenario-audio-heading">
+        <span className="scenario-audio-letter" aria-hidden="true">{audio.label}</span>
+        Música {audio.label}
+      </h2>
+      <div className={source ? 'scenario-player' : 'scenario-player scenario-player-unavailable'}
+        aria-disabled={!source}>
+        <AudioPlayer src={source} autoPlay={false} autoPlayAfterSrcChange={false}
+          preload="metadata" showJumpControls={false} customAdditionalControls={[]}
+          aria-label={`Player da música ${audio.label}`} />
+      </div>
+      {!source && <p className="scenario-audio-unavailable">Áudio ainda indisponível para reprodução.</p>}
+      <fieldset className="scenario-rating" disabled={disabled}>
+        <legend>Essa música combina com o contexto descrito acima?</legend>
+        <div className="scenario-scale">
+          {SCALE.map(option => (
+            <label key={option.value} className={`scenario-score${score === option.value ? ' is-selected' : ''}`}>
+              <input type="radio" name={`score-${audio.label}`} value={option.value}
+                checked={score === option.value} required
+                onChange={() => onScoreChange(option.value)} />
+              <span className="scenario-score-number">{option.value}</span>
+              <span>{option.text}</span>
+            </label>
+          ))}
+        </div>
+      </fieldset>
+    </section>
+  );
+}
