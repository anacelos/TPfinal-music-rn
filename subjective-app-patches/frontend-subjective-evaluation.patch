diff --git a/src/types/scenario_types.ts b/src/types/scenario_types.ts
new file mode 100644
index 0000000..65f56c3
--- /dev/null
+++ b/src/types/scenario_types.ts
@@ -0,0 +1,44 @@
+export const AUDIO_LABELS = ['A', 'B', 'C', 'D'] as const;
+export type AudioLabel = typeof AUDIO_LABELS[number];
+export type Score = 1 | 2 | 3 | 4 | 5;
+export type ScenarioScores = Record<AudioLabel, Score>;
+
+export interface ScenarioAudio {
+  label: AudioLabel;
+  public_id: string;
+}
+
+export interface ScenarioReservation {
+  scenario_id: string;
+  reservation_id: string;
+  reserved_until: string;
+  context_image: string | null;
+  game_description: string;
+  scene_description: string;
+  audios: ScenarioAudio[];
+}
+
+export interface ScenarioProgress {
+  completed_count: number;
+  target: number;
+  whether_complete: boolean;
+  reservations: ScenarioReservation[];
+}
+
+export interface ScenarioSubmission {
+  scenario_id: string;
+  reservation_id: string;
+  scores: ScenarioScores;
+  time_spent_ms: number;
+}
+
+export interface ScenarioSubmissionResult {
+  scenario_id: string;
+  status: 'COMPLETED';
+  already_completed: boolean;
+}
+
+export function scoresAreComplete(scores: Partial<ScenarioScores>): scores is ScenarioScores {
+  return AUDIO_LABELS.every(label => Number.isInteger(scores[label]) &&
+    scores[label]! >= 1 && scores[label]! <= 5);
+}
